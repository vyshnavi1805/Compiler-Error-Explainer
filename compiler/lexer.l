/* =====================================================================
   lexer.l
   -----------------------------------------------------------------
   A REAL Flex lexer for the same educational C subset used by the
   Python engine in backend/lexer.py. This file exists so you can show
   your professor an actual Flex specification (Section 35 of the
   project spec) and compare it side-by-side with the hand-written
   Python lexer -- the RULES are the same set of C tokens, only the
   tool differs.

   This file works TWO ways:

   1. STANDALONE (Phase 1 demonstration only):
        win_flex lexer.l
        gcc lex.yy.c -o lexer.exe -DSTANDALONE_LEXER -lfl
        lexer.exe < ..\examples\01_valid.c
      Prints every token it recognises, one per line.

   2. AS PART OF THE FULL PARSER (Phase 1 + Phase 2 together):
      parser.y includes this file's generated scanner and calls
      yylex() to pull one token at a time while parsing. See
      build.bat for the exact combined build command.
   ===================================================================== */

%option noyywrap
%option yylineno

%{
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#ifndef STANDALONE_LEXER
#include "parser.tab.h"   /* generated by: bison -d parser.y */
#endif

#ifdef STANDALONE_LEXER
/* In standalone mode we don't have real token codes from Bison, so we
   just print the lexeme and a human-readable category, exactly like
   the Token table in the web UI (Section 22). */
#define REPORT_AND_RETURN(tokname, code) \
    { printf("%-20s %-20s line %d\n", yytext, tokname, yylineno); }
#else
/* In parser mode we actually hand the token back to Bison, and store
   its value (if any) in yylval for the grammar rules to use. */
#define REPORT_AND_RETURN(tokname, code) { return code; }
#endif
%}

DIGIT       [0-9]
LETTER      [A-Za-z_]
IDENT       {LETTER}({LETTER}|{DIGIT})*
INT_CONST   {DIGIT}+
FLOAT_CONST {DIGIT}+\.{DIGIT}+([eE][+-]?{DIGIT}+)?[fF]?

%%

"#include"[ \t]*[<\"][^>\"\n]+[>\"]   { REPORT_AND_RETURN("PREPROCESSOR", 0); }

"//".*                                { /* single-line comment: ignore */ }
"/*"([^*]|\*+[^*/])*\*+"/"            { /* multi-line comment: ignore */ }

"int"      { REPORT_AND_RETURN("KEYWORD", INT); }
"float"    { REPORT_AND_RETURN("KEYWORD", FLOAT); }
"double"   { REPORT_AND_RETURN("KEYWORD", DOUBLE); }
"char"     { REPORT_AND_RETURN("KEYWORD", CHAR); }
"void"     { REPORT_AND_RETURN("KEYWORD", VOID); }
"if"       { REPORT_AND_RETURN("KEYWORD", IF); }
"else"     { REPORT_AND_RETURN("KEYWORD", ELSE); }
"while"    { REPORT_AND_RETURN("KEYWORD", WHILE); }
"for"      { REPORT_AND_RETURN("KEYWORD", FOR); }
"return"   { REPORT_AND_RETURN("KEYWORD", RETURN); }

{IDENT} {
#ifndef STANDALONE_LEXER
    yylval.sval = strdup(yytext);
#endif
    REPORT_AND_RETURN("IDENTIFIER", ID);
}

{FLOAT_CONST} {
#ifndef STANDALONE_LEXER
    yylval.dval = atof(yytext);
#endif
    REPORT_AND_RETURN("FLOAT_CONSTANT", FLOAT_CONST);
}

{INT_CONST} {
#ifndef STANDALONE_LEXER
    yylval.ival = atoi(yytext);
#endif
    REPORT_AND_RETURN("INT_CONSTANT", INT_CONST);
}

\"([^"\\]|\\.)*\" {
#ifndef STANDALONE_LEXER
    yylval.sval = strdup(yytext);
#endif
    REPORT_AND_RETURN("STRING_LITERAL", STRING_LIT);
}

'([^'\\]|\\.)' {
#ifndef STANDALONE_LEXER
    yylval.sval = strdup(yytext);
#endif
    REPORT_AND_RETURN("CHAR_LITERAL", CHAR_LIT);
}

"=="   { REPORT_AND_RETURN("OPERATOR", EQ); }
"!="   { REPORT_AND_RETURN("OPERATOR", NEQ); }
"<="   { REPORT_AND_RETURN("OPERATOR", LE); }
">="   { REPORT_AND_RETURN("OPERATOR", GE); }
"&&"   { REPORT_AND_RETURN("OPERATOR", AND); }
"||"   { REPORT_AND_RETURN("OPERATOR", OR); }

[+\-*/%=<>!(){}\[\];,] {
#ifdef STANDALONE_LEXER
    printf("%-20s %-20s line %d\n", yytext, "OPERATOR/DELIMITER", yylineno);
#else
    return yytext[0];
#endif
}

[ \t\r]+   { /* whitespace: ignore */ }
\n         { /* yylineno is auto-incremented by the "yylineno" option */ }

. {
    fprintf(stderr, "LEXICAL ERROR: unrecognised character '%s' on line %d\n", yytext, yylineno);
}

%%

#ifdef STANDALONE_LEXER
int main(int argc, char **argv) {
    printf("C Compiler Error Explainer - standalone Flex lexer (Phase 1 demo)\n");
    printf("%-20s %-20s %s\n", "LEXEME", "TOKEN", "LINE");
    printf("----------------------------------------------------\n");
    yylex();
    return 0;
}
#endif
